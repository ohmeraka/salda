# Supabase project settings (Project Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, never exposed to the browser. Used by
# src/lib/supabase/admin.ts for privileged operations (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ExchangeRate-API key (https://app.exchangerate-api.com/dashboard) — server-only,
# used to pre-fill the manual FX rate field in the Add/Edit sheet.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
